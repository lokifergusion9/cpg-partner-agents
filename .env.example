# Copy to .env and fill in what you need. Mirrors config.Settings (HLD §10).
# An empty value means "not set". Never commit the real .env.

# --- LLM ---------------------------------------------------------------
# gemini | groq | ollama | fake
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# For example a friend's machine over Tailscale
OLLAMA_BASE_URL=http://localhost:11434
# Model ids per role. Check each provider's console for current free-tier names.
LLM_MODEL_ROUTER=
LLM_MODEL_EXTRACTOR=
LLM_MODEL_WRITER=
# Call agent and eval roles. Empty -> classifier uses the router model, caller and simulator
# the writer model, judge the extractor model.
LLM_MODEL_CLASSIFIER=
LLM_MODEL_CALLER=
LLM_MODEL_SIMULATOR=
LLM_MODEL_JUDGE=
# Per-role provider override, role=provider:model (split on the first ':').
# Example: simulator=ollama:qwen2.5:7b,judge=groq:<model>
LLM_ROLES=
# Tried in order after the retries are spent on a 429 / quota / connection error.
# Example: groq:<model>,gemini:<model>
LLM_FALLBACKS=
# Cache model replies on disk (dev and eval runs). Empty = off. Example: ./.llm_cache
LLM_CACHE_DIR=
# Timeout for the friend's Ollama over Tailscale
OLLAMA_TIMEOUT_S=60
# Keeps calls under free-tier requests-per-minute limits
LLM_MAX_CONCURRENCY=4
# Per-request timeout in seconds
LLM_TIMEOUT_S=60

# --- Embeddings --------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Search ------------------------------------------------------------
# tavily | ddg
SEARCH_PROVIDER=tavily
SEARCH_FALLBACK=ddg
TAVILY_API_KEY=
# Comma-separated domains added to the built-in blocklist
SEARCH_DOMAIN_BLOCKLIST=

# --- Stores ------------------------------------------------------------
# Empty QDRANT_URL -> local Qdrant at QDRANT_LOCAL_PATH
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./.qdrant
# Empty MONGODB_URI -> in-memory repository
MONGODB_URI=
# Database name inside the cluster
MONGODB_DATABASE=partner_agents

# --- Retrieval ---------------------------------------------------------
CHUNK_TOKENS=1000
CHUNK_OVERLAP=150
EVIDENCE_K=4
EVIDENCE_MAX=6

# --- Charlie thresholds ------------------------------------------------
# Below this router confidence, the intent becomes "clarify"
ROUTER_MIN_CONFIDENCE=0.6
# Starting value; tuned on the kb dev split (EVAL §4.6)
KB_MIN_SCORE=0.5

# --- Fetching ----------------------------------------------------------
FETCH_TIMEOUT_S=10
FETCH_MAX_BYTES=2000000
# A page whose injection score reaches this is excluded (0.6 default; above 1 turns it off)
INJECTION_THRESHOLD=0.6
FETCH_CONCURRENCY=8

# --- Verification ------------------------------------------------------
VERIFY_MX=false
# Used to parse phones when the location has no country
DEFAULT_PHONE_REGION=US

# --- Outreach (safe defaults: nothing leaves the system) ---------------
# outbox | gmail_draft | gmail_send
OUTREACH_MODE=outbox
# Comma-separated. Required for gmail_send.
OUTREACH_ALLOWLIST=
OUTREACH_DAILY_CAP=20
OUTREACH_DEDUPE_DAYS=30
# OAuth installed-app files. Keep them OUTSIDE the repo.
# Defaults: ~/.partner_agents/gmail_credentials.json and ~/.partner_agents/gmail_token.json
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=

# --- Voice (stretch) ---------------------------------------------------
# mock | vapi
VOICE_PROVIDER=mock
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Comma-separated E.164 numbers that have consented to calls
VOICE_ALLOWLIST=

# --- Call agent --------------------------------------------------------
# Playbook file in data/playbooks/ (without .toml)
CALL_PLAYBOOK=partner_intro
# A call ends as "incomplete" after this many turns (or the playbook's max_turns, if smaller)
CALL_MAX_TURNS=30
# Longest agent line, in words (check C-LEN)
CALL_REPLY_MAX_WORDS=60

# --- Live voice (optional, ADR-021) ------------------------------------
# Needs `uv sync --extra speech`. Audio is processed in memory and never stored by this app.
SPEECH_ENABLED=false
# faster-whisper model: tiny, base (default, CPU) or small
WHISPER_MODEL=base
# Path to a Piper voice (.onnx; its .onnx.json file must sit beside it)
PIPER_VOICE=

# --- Tracing (enabled when both keys are set) --------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Logging -----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. Contact values are redacted at INFO and above.
LOG_LEVEL=INFO
# true makes a graph node re-raise unexpected exceptions instead of recording a StageError.
# Set it in tests and while debugging; leave it false in production.
STRICT_NODES=false

# --- API and demo ------------------------------------------------------
# When set, /api requires the X-API-Key header
APP_API_KEY=
# true forces outbox + mock voice and caps max_results at 5
DEMO_MODE=false
# Discovery runs per user/IP per hour
RATE_LIMIT_RUNS_PER_HOUR=5
# Retention for page snapshots and chunks
DATA_TTL_DAYS=7
